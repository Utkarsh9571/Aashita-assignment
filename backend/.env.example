# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================

# Database Connection String:
# - Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/meeting_rooms
# - Neon / Supabase / Render PostgreSQL (Cloud):
#   Both postgresql:// and postgres:// formats are automatically normalized.
#   Example: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_rooms

# Application Environment:
# "development" or "production"
ENVIRONMENT=development

# Server Port:
# On Render, this is dynamically assigned via the PORT environment variable.
PORT=8000

# Frontend URL (For Production Deployment on Vercel):
# Set this to your deployed Vercel domain so CORS headers permit requests.
FRONTEND_URL=https://<your-vercel-app>.vercel.app

# Allowed CORS Origins (Comma-separated list):
# Wildcard for local dev and *.vercel.app is allowed by default in app/main.py.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
