# PostgreSQL connection string
# For local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_rooms

# Application Settings
ENVIRONMENT=development
PORT=8000

# CORS Origins (comma-separated list of origins or "*" for development)
# In production, specify your Vercel deployment URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
