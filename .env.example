# ==============================================================================
# Meeting Room Booking System - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Environment Variables (Render / Local)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (supports local, Neon, Supabase, Render PostgreSQL)
# Both "postgres://" and "postgresql://" protocols are automatically handled.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_rooms

# Application runtime environment ("development" or "production")
ENVIRONMENT=development

# Server port (Render sets this dynamically via $PORT)
PORT=8000

# Deployed Frontend URL (Vercel domain)
FRONTEND_URL=https://<your-vercel-app>.vercel.app

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# ------------------------------------------------------------------------------
# 2. Frontend Environment Variables (Vercel / Local)
# ------------------------------------------------------------------------------
# Backend API Base URL
# - Local development: http://localhost:8000
# - Production on Vercel: https://<your-render-backend>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
